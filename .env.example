# Copy this file to .env and fill in your own key. Never commit .env.
# Get a free key at https://console.groq.com/keys -- no credit card required.
GROQ_API_KEY=gsk_your-key-here

# Optional: override the model used (defaults to openai/gpt-oss-120b).
# Groq deprecates/retires models periodically -- if this one stops working,
# check https://console.groq.com/docs/models for a current tool-calling-capable
# alternative (e.g. qwen/qwen3.6-27b) and set it here.
ASTER_ROW_MODEL=openai/gpt-oss-120b
